<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <IsTestProject>false</IsTestProject>
    <Description>Active patterns for XParsec: match parsers directly in F# `match` expressions.</Description>
    <!-- Sourcelink -->
    <PublishRepositoryUrl>https://github.com/mushedResearch/XParsec.ActiveParsers</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Fable.Package.SDK required properties -->
    <PackageTags>$(PackageTags);f#;parser;active-patterns;fable;fable-library;fable-javascript;fable-dotnet</PackageTags>
    <FablePackageType>library</FablePackageType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="ActiveParser.fs" />
    <Compile Include="Patterns.fs" />
    <Compile Include="CombinatorPatterns.fs" />
    <Compile Include="CharPatterns.fs" />
    <Compile Include="BytePatterns.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="XParsec" />
  </ItemGroup>
  <Import Project="../Fable.Package.SDK/Fable.Package.SDK.props" />
  <Import Project="../Fable.Package.SDK/Fable.Package.SDK.targets" />
</Project>
